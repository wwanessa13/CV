# Função normatiza realizando a normatização por linha: arquivo de entrada foi transposto antes
Normatiza<-function(ent, base, x0, x1)
{
for(i in 1:nrow(ent))
{
v_min<-min(base[i,])
v_max<-max(base[i,])
if (v_min == v_max)
ent[i,]<-ent[i,]
}
else
# Função normatiza realizando a normatização por linha: arquivo de entrada foi transposto antes
Normatiza<-function(ent, base, x0, x1)
{
for(i in 1:nrow(ent))
{
v_min<-min(base[i,])
v_max<-max(base[i,])
if (v_min == v_max)
{
ent[i,]<-ent[i,]
}
else
{
ent[i,]<-((ent[i,]-v_min)*(x1-x0)+ x0)/(v_max-v_min)
}
}
return(ent) # Retornando os dados normalizada
}
dados<-read.table("MLP1.txt",header=F)
head(dados)
entradaOrig = t(dados[,2:ncol(dados)])
# Grafico inicial para ver se populacoes sao linearmente separáveis
plot(dados[,2], dados[,3], col=dados[,1], pch=dados[,1],xlab="Var1", ylab="Var2", main="Grafico de Dispersao das Pop 1 e 2")
legend("topright", legend = unique(dados[,1]), col=unique(dados[,1]), pch=unique(dados[,1]))
entrada<-t(Normatiza(entradaOrig,entradaOrig,0,1))
saida_dOrig = t(dados[,1])
saida= t(Normatiza(saida_dOrig,saida_dOrig,0,1))
dados=cbind(saida, entrada)
colnames(dados)= c("pop", "x1", "x2")
dados
## Parametros Iniciais
epocas=30000
## Estabelecimento da rede
library(neuralnet)
net <- neuralnet(pop ~ x1+x2, linear.output = FALSE, hidden = c(3,3), stepmax = epocas, algorithm = "rprop+", act.fct="logistic", rep=1, data= dados, err.fct = "sse")
plot(net, rep="best")
Pred <- compute(net,dados[,-1])
saidaR <- round(Pred$net.result, 0)
erro = saida - saidaR
sqerro= sum((saida - saidaR)^2)
## Matriz de confusao
matriz<-table(saida, saidaR)
matriz
## Acuracia
acuracia <- sum(diag(matriz[,])) / sum(matriz[,])
acuracia
